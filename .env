# ASDP Pos Jembatan Timbang Frontend - Local Environment
NEXT_PUBLIC_WEIGHBRIDGE_API_URL=http://localhost:8090
NEXT_PUBLIC_LOKET_API_URL=http://localhost:8080
NEXT_PUBLIC_LOKET_ADAPTER_URL=http://localhost:7777
PORT=3005
# Konfigurasi input barcode timbangan bisa diedit manual (true = editable / false = scanner only)
NEXT_PUBLIC_ALLOW_MANUAL_INPUT=true
# Konfigurasi apakah nilai bobot <= 0 boleh diproses (true = tampilkan konfirmasi TETAP PROSES / BATAL, false = blokir TUTUP)
NEXT_PUBLIC_ALLOW_ZERO_OR_NEGATIVE_WEIGHT=false
